---
interface Props {
    images: string[];
    title: string;
}

const {
    images,
    title
} = Astro.props;

const galleryId =
    `gallery-${Math.random().toString(36).substring(2,9)}`;
---

<div
  id={galleryId}
  class="project-gallery"
>


<div
  class="
    aspect-video
    overflow-hidden
    rounded-lg
    border
    border-accent2/30
  "
>

<img
  class="gallery-image w-full h-full object-cover"
  src={images[0]}
  alt={images[0]}
/>

</div>



<!-- Controls -->

<div
 class="
   mt-5
   flex
   justify-center
   items-center
   gap-6
 "
>


<button
 class="gallery-prev text-accent2"
>
◀
</button>



<div 
  class="flex gap-3"
  id={`${galleryId}-dots`}
>

{
 images.map((_,i)=>(
   
   <span
    class:list={[
      "gallery-dot",
      {"active": i===0}
    ]}
    data-index={i}
   ></span>

 ))
}

</div>



<button
 class="gallery-next text-accent2"
>
▶
</button>


</div>


</div>



<script define:vars={{images, galleryId}}>

const gallery =
document.getElementById(galleryId);


const image =
gallery.querySelector(".gallery-image");


const dots =
gallery.querySelectorAll(".gallery-dot");


const next =
gallery.querySelector(".gallery-next");


const prev =
gallery.querySelector(".gallery-prev");


let galleryImages = images;
let current = 0;

const dotsContainer =
    gallery.querySelector(`#${galleryId}-dots`);

function updateGallery(index){

    current =
        (index + galleryImages.length) %
        galleryImages.length;

    image.src =
    galleryImages[current];

    image.alt =
    galleryImages[current];


    const dots =
        gallery.querySelectorAll(".gallery-dot");


    dots.forEach((dot,i)=>{

        dot.classList.toggle(
            "active",
            i===current
        );

    });

}



next.addEventListener(
"click",
()=>updateGallery(current+1)
);



prev.addEventListener(
"click",
()=>updateGallery(current-1)
);



// Mobile swipe

let startX = 0;


gallery.addEventListener(
"touchstart",
(e)=>{

    startX =
    e.touches[0].clientX;

});


gallery.addEventListener(
"touchend",
(e)=>{

    const endX =
    e.changedTouches[0].clientX;


    const diff =
    endX-startX;


    if(Math.abs(diff)<40)
        return;


    if(diff < 0)
        updateGallery(current+1);

    else
        updateGallery(current-1);

});



dots.forEach((dot)=>{

    dot.addEventListener(
    "click",
    ()=>{

        updateGallery(
            Number(dot.dataset.index)
        );

    });

});


document.addEventListener(
    "project-gallery-update",
    (event) => {

        galleryImages =
            event.detail.images;

        current = 0;

        image.src =
            galleryImages[current];
        
        image.alt =
            galleryImages[current];

        // Rebuild dots
        dotsContainer.innerHTML = "";

        galleryImages.forEach((_, i) => {

            const dot =
                document.createElement("span");

            dot.className =
                "gallery-dot";

            if (i === 0) {
                dot.classList.add("active");
            }

            dot.dataset.index =
                String(i);

            dot.addEventListener(
                "click",
                () => updateGallery(i)
            );

            dotsContainer.appendChild(dot);

        });

    }
);

</script>
